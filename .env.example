# ===== OCR provider（智谱 GLM-OCR，复用 OCR-Page 经验）=====
# 从 https://open.bigmodel.cn 获取；可复用 OCR-Page 的同一个 GLM_API_KEY
GLM_API_KEY=

# 智谱 layout_parsing 端点与模型（通常不用改）
GLM_OCR_URL=https://open.bigmodel.cn/api/paas/v4/layout_parsing
GLM_OCR_MODEL=glm-ocr

# ===== AI 老师 tutor provider =====
# 默认 provider：deepseek / glm / kimi（三选一）
TUTOR_PROVIDER=deepseek
# 对应模型名
TUTOR_MODEL=deepseek-chat
# 数学题建议用推理模型（如 deepseek-reasoner），算错率明显更低，但更慢
# 对应 API Key（deepseek / glm / moonshot 各自的 key）
TUTOR_API_KEY=
# 对应 base URL
#   deepseek: https://api.deepseek.com
#   glm:      https://open.bigmodel.cn/api/paas/v4
#   kimi:     https://api.moonshot.cn/v1
TUTOR_BASE_URL=https://api.deepseek.com

# 支持图像的 vision provider（用于含图题，可选）
# 不配置时含图题仍可讲解，但 AI 看不到原图，会明确能力限制
TUTOR_VISION_PROVIDER=glm
TUTOR_VISION_MODEL=glm-4v
TUTOR_VISION_API_KEY=
TUTOR_VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ===== 鉴权 =====
# JWT 密钥，生产必须设置且 >= 32 字节（openssl rand -hex 32）
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
# 注册邀请码，生产必须设置；为空则允许任意人注册
INVITE_CODE=your-invite-code

# ===== 服务监听 =====
PORT=3005
HOST=127.0.0.1

# ===== 限流（可选）=====
# 每 10 分钟每用户 tutor 调用上限（默认 20）
# RATE_MAX_TUTOR=20
# tutor 调用超时（毫秒，默认 120000）
# TUTOR_TIMEOUT_MS=120000
# 讲解温度（默认 0.3，数学推导宜低）与输出上限（默认 4096，推理模型可调大）
# TUTOR_TEMPERATURE=0.3
# TUTOR_MAX_TOKENS=4096
# OCR 调用超时（毫秒，默认 120000）
# OCR_TIMEOUT_MS=120000
# 单图最大字节（默认 10MB）
# MAX_IMAGE_BYTES=10485760

# 后台队列；空值使用默认值。仅支持单进程 worker。
OCR_CONCURRENCY=
GRADE_CONCURRENCY=
DAILY_OCR_MAX=
DAILY_GRADE_MAX=
# 仅本地测试显式设置 1，生产环境留空
OCR_MOCK=
# 测试隔离目录，生产环境留空沿用 data/ 和 uploads/
LEARNPLAT_DATA_DIR=
LEARNPLAT_UPLOAD_DIR=

# 可选服务端作文批改。客户端导出/导入和 MCP 不需要这些配置。
ESSAY_PROVIDER=
ESSAY_MODEL=
ESSAY_BASE_URL=
ESSAY_API_KEY=
ESSAY_MOCK=
